# ==============================================================================
# AI-VAPT Platform — Environment Configuration Template
# Copy to .env and configure as needed. .env is excluded from git version control.
# ==============================================================================

# --- AI Providers Configuration (Optional) ---
# Note: The web interface supports in-memory API key validation.
# Runtime keys entered in the UI are held in memory only and never written to disk.
# Configure environment variables below if running headlessly or via CLI.

# OpenRouter (Supports 10+ free models: Llama 3.3 70B, DeepSeek R1, Gemma, Qwen)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Google Gemini API
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# OpenAI API
# OPENAI_API_KEY=

# Local Ollama (Defaults to http://localhost:11434 with zero external network access)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:1.5b

# Generic Cloud Hosted (OpenAI-Compatible custom endpoints: llama.cpp, vLLM, Kaggle)
# LLM_API_BASE=https://your-inference-endpoint/v1
# LLM_API_KEY=your-api-key
# STRIX_LLM=kaggle-model

# --- Server & Gateway Settings ---
# STRIX_WEB_PORT=8000
# STRIX_WEB_HOST=0.0.0.0

