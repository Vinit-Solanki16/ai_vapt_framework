              "shortDescription": {
                "text": "Coverage: Client-Side Insecure JavaScript Processing"
              },
              "fullDescription": {
                "text": "Coverage of Client-Side Insecure JavaScript Processing across the assessed attack surface."
              },
              "defaultConfiguration": {
                "level": "none"
              },
              "help": {
                "text": "Coverage of Client-Side Insecure JavaScript Processing across the assessed attack surface.",
                "markdown": "Coverage of Client-Side Insecure JavaScript Processing across the assessed attack surface."
              },
              "properties": {
                "tags": [
                  "coverage"
                ]
              }
            }
          ],
          "version": "1.7.0"
        }
      },
      "results": [
        {
          "ruleId": "strix-coverage/client-side-insecure-javascript-processing",
          "ruleIndex": 0,
          "kind": "open",
          "level": "none",
          "message": {
            "text": "Client-Side Insecure JavaScript Processing — Requires further review: /\n\nInitial analysis of client-side JavaScript did not reveal any obvious DOM-based XSS sinks (innerHTML, document.write, eval, etc.). Further dynamic analysis may be required to confirm if there are any client-side vulnerabilities."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "/"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "needs_follow_up",
              "risk_area": "Client-Side Insecure JavaScript Processing",
              "surface": "/",
              "recorded_by": "Root Agent",
              "source": "agent_reported"
            }
          }
        }
      ],
      "invocations": [
        {
          "executionSuccessful": false,
          "toolExecutionNotifications": [
            {
              "level": "warning",
              "message": {
                "text": "The scan ended with status 'stopped' rather than completing, so coverage reflects only the work finished before it stopped."
              }
            },
            {
              "level": "warning",
              "message": {
                "text": "1 agent(s) did not finish cleanly (Root Agent); any surface they held is under-covered."
              }
            },
            {
              "level": "warning",
              "message": {
                "text": "The run terminated via 'user_exit' rather than the root agent finishing, so remaining scope was not reached."
              }
            }
          ]
        }
      ]
    }
  ]
