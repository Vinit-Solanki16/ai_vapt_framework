      "results": [
        {
          "ruleId": "strix-coverage/robots-exclusion-protocol-information-disclosure",
          "ruleIndex": 0,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Robots Exclusion Protocol Information Disclosure — No issue identified: /robots.txt\n\nThe robots.txt file only disallows the /ftp path, which is a standard practice and not sensitive information disclosure. No internal configuration or sensitive directories are exposed."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "/robots.txt"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "no_issue_found",
              "risk_area": "Robots Exclusion Protocol Information Disclosure",
              "surface": "/robots.txt",
              "recorded_by": "Root Agent",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/sensitive-directory-and-endpoint-information-disclosure",
          "ruleIndex": 1,
          "kind": "pass",
          "level": "none",
          "message": {
